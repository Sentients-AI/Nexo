includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6

    # Application and project code. Test files are covered by Pest's own
    # architecture tests (tests/Arch/) and Pint; Pest's functional
    # test API is not statically analysable by PHPStan without full Pest support.
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
        - public/index.php
        # Test infrastructure that guards the test database (ADR-0009 §3a).
        - tests/bootstrap.php
        - tests/CreatesApplication.php
        - tests/TestCase.php
        - tests/Support
        - tests/Concurrency/Harness
        - tests/Concurrency/Scenarios
        - tests/Concurrency/bin
        # Project PHPStan rules (dependency-rules.md).
        - tests/Arch/PHPStan

    tmpDir: build/phpstan

rules:
    # L4: only VendorLifecycle writes a Vendor's status.
    - Tests\Arch\PHPStan\VendorStatusWriteRule
    # L8: only CreateVendor creates a Vendor.
    - Tests\Arch\PHPStan\VendorCreationRule
    # L9: only the audited orchestrators call CreateVendor::handle() and the lifecycle transitions.
    - Tests\Arch\PHPStan\VendorOrchestrationRule
    # L10: audit_log is append-only; AuditRecorder's insert is its only write.
    - Tests\Arch\PHPStan\AuditLogMutationRule
    - Tests\Arch\PHPStan\MembershipWriteRule
